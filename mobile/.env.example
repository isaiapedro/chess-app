# Leave unset to auto-detect the Metro host (recommended; survives LAN IP changes).
# Only used for thin VPC calls: explorer, masters-pgn, baselines.
# Always point at Metro's port 8081 (it proxies /api and /health):
# EXPO_PUBLIC_API_URL=http://192.168.1.19:8081

# Lichess OAuth (mobile PKCE) uses reverse-domain scheme
# com.chesswrapped.app://oauth — register that exact redirect URI with Lichess.
# client_id defaults to chess-wrapped-mobile in AuthContext.
