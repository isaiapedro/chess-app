# Optional. Required for reliable Lichess Opening Explorer (masters/lichess/player).
# Create at: https://lichess.org/account/oauth/token
LICHESS_TOKEN=

# Thin VPC: mobile owns user-game ingest + Recap/Insights. Server games/session/stats
# routes are optional for scripts only; the Expo happy path does not call them.

# Upstream games disk-store freshness (seconds). Legacy/script server ingest only.
# Default 86400 (24h). Set 0 to always refresh on memo miss.
GAMES_FETCH_TTL_SEC=86400

# Session stats disk cache TTL (seconds). Legacy/script server stats only. Min 24h.
STATS_DISK_TTL_SEC=86400

# Per-process asyncio semaphore caps (defaults shown). No Redis.
API_SEM_LOAD=12
API_SEM_CPU=3
API_SEM_STUDY=6
API_SEM_CHEAP=32

# Opening explorer rate-limit / concurrency knobs (cache.py).
# LICHESS_EXPLORER_BASE=https://explorer.lichess.org
EXPLORER_SOFT_COOLDOWN_SEC=8
EXPLORER_SOFT_COOLDOWN_CAP_SEC=20
MASTERS_PGN_SOFT_COOLDOWN_SEC=5
EXPLORER_CONCURRENCY=3
