# Optional. Required for reliable Lichess Opening Explorer (masters/lichess/player).
# Create at: https://lichess.org/account/oauth/token
LICHESS_TOKEN=

# Data residency:
# - Server (.cache): usernames + emails (users/registry.json) and peer metrics (baselines/).
# - Mobile device: user games, Stockfish vault, recap/insights/study caches.
# Do NOT enable server-side user-game caches on the API host.
# ALLOW_SERVER_USER_GAMES_CACHE=0

# Opening explorer rate-limit / concurrency knobs (cache.py).
# LICHESS_EXPLORER_BASE=https://explorer.lichess.org
EXPLORER_SOFT_COOLDOWN_SEC=8
EXPLORER_SOFT_COOLDOWN_CAP_SEC=20
MASTERS_PGN_SOFT_COOLDOWN_SEC=5
EXPLORER_CONCURRENCY=3

# Per-process asyncio semaphore caps (defaults shown). No Redis.
API_SEM_LOAD=12
API_SEM_CPU=3
API_SEM_STUDY=6
API_SEM_CHEAP=32
